#!/bin/bash
# Headscale + provisioning service -- VM setup script.
#
# Runs as root via the Azure CustomScript extension. Rendered by templatefile() in
# compute.tf, so this is a Terraform template rather than a plain script, and the two
# variable syntaxes collide:
#
#     $${name}    Terraform substitutes this at plan time
#     $$${name}   renders to a literal $${name} -- the shell expands it at run time
#
# Every shell variable below is therefore doubled. Adding an undoubled one silently hands
# it to Terraform, which fails with "Invalid function argument" if it is not a declared
# template variable -- or, worse, substitutes an empty string if it is.
#
# Re-runs safely. The extension re-executes this whenever the rendered content changes,
# against the existing VM -- no reprovision, no lost state. Everything below is written to
# tolerate that: package installs are idempotent, config files are overwritten wholesale,
# and the headscale database is never touched.
set -euox pipefail

DOMAIN="${domain}"
ADMIN_EMAIL='${admin_email}'

# -- Helpers ---------------------------------------------------------------
log() { echo "[setup] $*"; }
retry() {
  local n=0
  until [ "$n" -ge 5 ]; do
    "$@" && return 0
    n=$((n+1))
    log "Retrying ($n/5)..."
    sleep 5
  done
  return 1
}

# -- 1. System packages ----------------------------------------------------
log "Installing system packages..."
export DEBIAN_FRONTEND=noninteractive
apt-get update -qq
apt-get install -y -qq \
  curl wget jq git nginx certbot python3-certbot-nginx \
  ca-certificates gnupg lsb-release

# -- 2. Go -----------------------------------------------------------------
log "Installing Go..."
GO_VERSION=${go_version}
wget -q -O /tmp/go.tar.gz "https://go.dev/dl/go$${GO_VERSION}.linux-${arch}.tar.gz"
rm -rf /usr/local/go
tar -C /usr/local -xzf /tmp/go.tar.gz
export PATH=/usr/local/go/bin:$PATH
export GOPATH=/root/go
export GOMODCACHE=/root/go/pkg/mod
go version

# -- 3. Headscale ----------------------------------------------------------
log "Installing Headscale..."
HS_VERSION=${headscale_version}
HS_VER="$${HS_VERSION#v}"
retry wget -q -O /tmp/headscale.deb \
  "https://github.com/juanfont/headscale/releases/download/$${HS_VERSION}/headscale_$${HS_VER}_linux_${arch}.deb"
dpkg -i /tmp/headscale.deb

mkdir -p /etc/headscale /var/lib/headscale

# listen_addr, grpc_listen_addr and metrics_listen_addr are all bound to 127.0.0.1. Nginx
# is the only thing that reaches headscale, and it does so over loopback. This is why the
# network security group opens no port for gRPC: nothing is listening on a public
# interface for it to reach. See network.tf.
cat > /etc/headscale/config.yaml <<EOF
server_url: https://$${DOMAIN}
listen_addr: 127.0.0.1:8080
grpc_listen_addr: 127.0.0.1:50443
metrics_listen_addr: 127.0.0.1:9090

log:
  level: info

noise:
  private_key_path: /var/lib/headscale/noise_private.key

prefixes:
  v4: 100.64.0.0/10
  v6: fd7a:115c:a1e0::/48
  allocation: sequential

database:
  type: sqlite
  sqlite:
    path: /var/lib/headscale/db.sqlite

dns:
  override_local_dns: true
  nameservers:
    global:
      - 1.1.1.1
  base_domain: ${base_domain}

derp:
  server:
    enabled: false
  urls:
    - https://controlplane.tailscale.com/derpmap/default
  auto_update_enabled: true
  update_frequency: 3h

policy:
  mode: file
  path: /etc/headscale/policy.hujson
EOF

# Allow all node-to-node traffic, spelled out so the intent is visible here. Access control
# is quark's own HTTP login, not the tailnet; the tailnet is open by design. Tightening it is
# future work, tied to how an owner's phone pairs with their quark. Beware: an empty "acls"
# list is headscale's deny-all (docs/ref/acls.md), and omitting "acls" is an implicit allow-all.
# A rule with no "proto" covers only TCP and UDP in 0.28, and "proto": "*" is rejected, so ICMP
# (ping) needs a rule of its own.
cat > /etc/headscale/policy.hujson <<'POLICY'
{
  "acls": [
    { "action": "accept", "src": ["*"], "dst": ["*:*"] },
    { "action": "accept", "src": ["*"], "dst": ["*:*"], "proto": "icmp" }
  ]
}
POLICY

systemctl enable headscale
systemctl restart headscale
log "Headscale started."

# -- 4. Nginx (HTTP only first -- TLS after DNS propagates) ----------------
log "Configuring Nginx..."
rm -f /etc/nginx/sites-enabled/default

cat > /etc/nginx/sites-available/headscale <<EOF
server {
    listen 80;
    server_name $${DOMAIN};
    location / {
        proxy_pass http://127.0.0.1:8080;
        proxy_set_header Host \$host;
        proxy_set_header X-Real-IP \$remote_addr;
        proxy_set_header X-Forwarded-For \$proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto \$scheme;
        proxy_http_version 1.1;
        proxy_set_header Upgrade \$http_upgrade;
        proxy_set_header Connection "upgrade";
    }
    # The provisioning service binds loopback only, so this is its sole way in, and it
    # shares the certbot certificate with headscale.
    location /provision {
        proxy_pass http://127.0.0.1:8081;
        proxy_set_header Host \$host;
        proxy_set_header X-Real-IP \$remote_addr;
        proxy_set_header X-Forwarded-For \$proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto \$scheme;
    }
}
EOF
ln -sf /etc/nginx/sites-available/headscale /etc/nginx/sites-enabled/headscale
nginx -t
systemctl reload nginx
log "Nginx configured (HTTP only, TLS pending DNS)."

# -- 5. TLS -- deliberately non-fatal, retried by a timer ---------------------
# certbot cannot succeed until $${DOMAIN} resolves to this VM's public IP, and on a new zone
# that waits on the one-time NS delegation at Porkbun. A first boot can therefore fail here
# under normal conditions, so this must not abort the script: everything below it -- the
# provisioning binary and its unit -- has nothing to do with TLS and should still land.
#
# headscale-certbot.timer retries every 20 minutes until a certificate exists, after which
# its ConditionPathExists skips the service. Three tries an hour, plus the direct run below,
# stays under Let's Encrypt's five failed validations per hostname per hour. Renewal is
# certbot's own certbot.timer, shipped by the package, not this one.
#
# The direct run below stays, rather than just starting the service, because it is also what
# puts TLS back after a re-run: step 4 rewrites the nginx site as plain HTTP, and certbot
# reinstalls the existing certificate into it. The timer's condition would skip that.
CERTBOT_CMD="certbot --nginx -d $${DOMAIN} --non-interactive --agree-tos -m $${ADMIN_EMAIL} --redirect"

cat > /etc/systemd/system/headscale-certbot.service <<EOF
[Unit]
Description=Obtain the TLS certificate for $${DOMAIN} once its DNS resolves
ConditionPathExists=!/etc/letsencrypt/live/$${DOMAIN}/fullchain.pem
After=network-online.target nginx.service
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/bin/$${CERTBOT_CMD}
EOF

cat > /etc/systemd/system/headscale-certbot.timer <<'EOF'
[Unit]
Description=Retry the headscale TLS certificate until one exists

[Timer]
OnCalendar=*:0/20

[Install]
WantedBy=timers.target
EOF

systemctl daemon-reload
systemctl enable --now headscale-certbot.timer

log "Attempting TLS certificate (non-fatal if DNS not propagated yet)..."
$${CERTBOT_CMD} \
  && log "TLS certificate issued." \
  || log "WARNING: certbot failed, most likely because DNS does not point here yet. headscale-certbot.timer retries every 20 minutes; see: journalctl -u headscale-certbot"

# -- 6. Provisioning service -----------------------------------------------
rm -rf ${source_dir}
git clone --depth 1 --branch ${repo_ref} ${repo_url} ${source_dir}

cd ${source_dir}
GOPATH=/root/go GOMODCACHE=/root/go/pkg/mod GOCACHE=/root/go/cache \
  /usr/local/go/bin/go build -o /usr/local/bin/${service_name} ${provisioning_package}
log "Provisioning binary installed at /usr/local/bin/${service_name}"

# -- 7. Provisioning service systemd unit ----------------------------------
# The service mints pre-auth keys by running the headscale CLI, which talks to headscale
# over its unix socket and needs no API key. headscale's defaults put that socket at
# /var/run/headscale/headscale.sock with mode 0770, inside headscale.service's
# RuntimeDirectory (/run/headscale, 0750, owned by headscale). Running as User=headscale is
# what grants access to it. The config above sets no cli.address, and nothing here may set
# HEADSCALE_CLI_ADDRESS: either one sends the CLI to remote gRPC, which demands an API key.
# The binary is /usr/bin/headscale, on the default systemd PATH.
cat > /etc/systemd/system/${service_name}.service <<'UNIT'
[Unit]
Description=Quark Provisioning Service
After=network.target headscale.service
Requires=headscale.service

[Service]
Type=simple
User=headscale
Environment=PROVISIONING_LISTEN_ADDR=127.0.0.1:8081
Environment=HEADSCALE_USER=quark
EnvironmentFile=${config_dir}/provisioning.env
ExecStart=/usr/local/bin/${service_name}
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
UNIT

# -- 8. Provisioning secret -------------------------------------------------
# From var.provisioning_secret, via protected_settings. The file is owned by this script
# and rewritten whole on every run, which is also how a rotated secret lands; a hand edit
# is lost on the next apply.
#
# Tracing is off for this block: under `set -x` bash would echo the decoded value to stderr,
# and the extension reports stderr's tail to ARM. printf is a builtin and base64 reads a
# here-string, so the value never appears in a process's argv either. mktemp creates the
# file 0600 and mv swaps it in atomically, so the service never reads a half-written file.
set +x
mkdir -p ${config_dir}
ENV_TMP="$(mktemp ${config_dir}/.provisioning.env.XXXXXX)"
SECRET="$(base64 -d <<<'${secret_b64}')"
printf 'PROVISIONING_SECRET=%s\n' "$${SECRET}" > "$${ENV_TMP}"
unset SECRET
chown headscale:headscale "$${ENV_TMP}"
mv -f "$${ENV_TMP}" ${config_dir}/provisioning.env
set -x
log "Wrote PROVISIONING_SECRET to ${config_dir}/provisioning.env."

# -- 9. Tailnet user --------------------------------------------------------
# The user pre-auth keys are minted for. Must match HEADSCALE_USER in the unit above. The
# socket appears a moment after headscale starts, hence the retry on the first call.
retry headscale users list >/dev/null
if headscale users list -o json | jq -e '.[]? | select(.name == "quark")' >/dev/null; then
  log "headscale user quark already exists."
else
  headscale users create quark
fi

# -- 10. Start ---------------------------------------------------------------
# restart rather than start, so a re-run picks up a rebuilt binary and a rotated secret.
systemctl daemon-reload
systemctl enable ${service_name}
systemctl restart ${service_name}

log "Setup complete. Public IP: $(curl -s ifconfig.me)"
log "Nothing left to do on this host. If TLS is still pending, headscale-certbot.timer"
log "retries every 20 minutes -- on a new DNS zone that waits on the one-time NS delegation"
log "at Porkbun. Check: systemctl list-timers headscale-certbot.timer"
